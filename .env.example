# ════════════════════════════════════════════════════════════════════
# Bazares API — variáveis de ambiente
# Copia para `.env` (local) ou define no painel do Render (produção).
# NUNCA faças commit do `.env` real. Este ficheiro só tem NOMES, sem valores.
# Validado no arranque por src/config/env.js
# ════════════════════════════════════════════════════════════════════

# ── Ambiente ────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=
PORT=3001
# OBRIGATÓRIA em produção. Origens permitidas para CORS/Socket.IO, separadas
# por vírgula, sem barra final e SEM "*". Ex.: https://bazares.co.mz,https://www.bazares.co.mz
FRONTEND_URL=

# ── Base de dados (PostgreSQL) — OBRIGATÓRIA ────────────────────────
# Neon/Supabase: usa a connection string com pooler + ?sslmode=require
DATABASE_URL=

# ── Autenticação — OBRIGATÓRIAS (>= 32 caracteres e diferentes em produção)
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
BCRYPT_ROUNDS=12

# Login social (opcionais)
GOOGLE_CLIENT_ID=
# OBRIGATÓRIOS em conjunto para o login com Facebook (o APP_ID serve para confirmar que o token
# foi emitido para a NOSSA app; sem ele o login com Facebook fica desligado de propósito)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=

# ── Conta admin inicial (só usada por prisma/seed.js) ───────────────
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
BAZARBOT_EMAIL=

# ── Cloudinary (imagens/vídeo) — sem isto os uploads falham ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ───────────────────────────────────────────────────────────
# Envio por API HTTPS (o Render free bloqueia SMTP). Resend é o prioritário.
RESEND_API_KEY=
# Sem domínio verificado: deixar EMAIL_FROM_ADDRESS vazio (usa onboarding@resend.dev,
# que só envia para o email da conta Resend). Com domínio: no-reply@seudominio.com
EMAIL_FROM_NAME=Bazares
EMAIL_FROM_ADDRESS=
SUPPORT_EMAIL=bazares03@gmail.com
# Opcional: URL pública do banner animado (por omissão vai embutido em cada email).
# Ex.: https://bazares.co.mz/icons/email-banner.gif
EMAIL_BANNER_URL=
# Alternativa (só usada se RESEND_API_KEY estiver vazia)
SENDGRID_API_KEY=

# ── ZumboPay (M-Pesa / e-Mola) ──────────────────────────────────────
# OBRIGATÓRIA em produção: sem o secret, TODOS os webhooks de pagamento são rejeitados.
ZUMBOPAY_WEBHOOK_SECRET=
ZUMBOPAY_API_KEY=
ZUMBOPAY_MERCHANT_ID=
ZUMBOPAY_BASE_URL=
ZUMBOPAY_WALLET_MPESA=
ZUMBOPAY_WALLET_EMOLA=
ZUMBOPAY_TIMEOUT_MS=12000
STK_INFLIGHT_EXPIRY_MIN=6

# ── Regras de negócio ───────────────────────────────────────────────
DEFAULT_FEE_RATE=
FEE_LIMIT_MT=
FEE_PAYMENT_NAME=
FEE_PAYMENT_NUMBER=
PREMIUM_PRICE_MT=
PREMIUM_FEE_RATE=

# ── Rate limiting (opcionais — têm valores por omissão) ─────────────
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
ORDER_RATE_LIMIT_MAX=
AI_RATE_LIMIT_MAX=

# ── Push (Firebase Admin) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── IA (Gemini) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Funcionalidades (kill switches) — LIGADAS por omissão; false/0/off/no desligam ──
ENABLE_AI=
ENABLE_PAYMENTS=
ENABLE_PREMIUM=
ENABLE_REELS=
ENABLE_COMMUNITIES=
ENABLE_SOCIAL_FEED=

# ── Outros limites (opcionais) ──────────────────────────────────────
LOW_STOCK_THRESHOLD=3
WEBHOOK_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_MAX=120

# ── Observabilidade ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Operações ───────────────────────────────────────────────────────
BACKUP_KEEP=14
# Só para o Dockerfile/entrypoint: permite `prisma db push` (SEM --accept-data-loss)
# quando ainda não existe prisma/migrations. Deixa VAZIO em produção normal.
ALLOW_DB_PUSH=

# ── Diagnóstico ─────────────────────────────────────────────────────
# Se definido, /sentry-test?token=<valor> dispara um erro de teste. Vazio = rota desligada (404).
SENTRY_TEST_TOKEN=

# ── Limites de taxa (opcionais; têm valor por omissão no código) ────
ACCOUNT_SECURITY_RATE_LIMIT_MAX=
WALLET_MONEY_RATE_LIMIT_MAX=
WALLET_LOOKUP_RATE_LIMIT_MAX=
