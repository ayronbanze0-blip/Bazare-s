{
  "_readme": "Fonte única de verdade das chaves de resposta ('data.*') que o frontend espera de cada endpoint. Gerado a partir de uma auditoria linha-a-linha do frontend (grep a todos os 'res?.data?.X' associados a cada chamada api.*). Sempre que um controller mudar o nome de uma chave devolvida, response-shape.test.js falha — é o mesmo tipo de bug que causou 'Favoritos' a aparecer sempre vazio (backend devolvia 'favorites', frontend lia 'products'). Ao adicionar/alterar um endpoint: 1) actualizar aqui a chave exacta lida pelo frontend, 2) actualizar o controller, 3) correr `npm test`.",

  "GET /products": { "dataKeys": ["products", "meta"] },
  "GET /products/featured": { "dataKeys": ["products"] },
  "GET /products/categories-overview": { "dataKeys": ["categories"] },
  "GET /products/:id": { "dataKeys": ["product"] },
  "POST /products": { "dataKeys": ["product", "imageUploadErrors"] },
  "PUT /products/:id": { "dataKeys": ["product", "imageUploadErrors"] },
  "GET /products/:id/related": { "dataKeys": ["products"] },
  "GET /products/mine": { "dataKeys": ["products", "meta"] },
  "GET /products/favorites": { "dataKeys": ["products"] },
  "POST /products/:productId/favorite": { "dataKeys": ["isFavorite"] },
  "PATCH /products/:id/toggle": { "dataKeys": ["active"] },
  "PATCH /products/:id/stock": { "dataKeys": ["stock", "outOfStock"] },

  "GET /home": { "dataKeys": ["stories", "feed", "feedNextCursor", "reels", "featuredProducts", "newProducts", "featuredBazars", "categories"] },
  "GET /explore": { "dataKeys": ["categories", "trendingProducts", "trendingReels", "topBazars", "featuredBazars"] },
  "GET /products/:id/view": { "dataKeys": ["product", "bazar", "reviews", "relatedProducts", "sellerProducts", "recommendedReels", "comments", "viewer"] },
  "GET /bazars/:idOrSlug/view": { "dataKeys": ["bazar", "owner", "products", "posts", "reels", "stats", "viewer"] },

  "GET /content/:targetType/:targetId": { "dataKeys": ["content"] },
  "POST /feed/:targetType/:targetId/save": { "dataKeys": ["saved"] },
  "GET /feed/saved": { "dataKeys": ["items", "meta"] },
  "GET /posts": { "dataKeys": ["posts", "meta"] },
  "GET /posts/:id": { "dataKeys": ["post"] },
  "GET /reels/:id": { "dataKeys": ["reel"] },
  "GET /products/:id/reviews": { "dataKeys": ["reviews", "summary", "meta"] },
  "GET /products/:id/seller-products": { "dataKeys": ["products", "meta"] },
  "GET /bazars/:idOrSlug/products": { "dataKeys": ["products", "meta"] },
  "GET /bazars/:idOrSlug/reviews": { "dataKeys": ["reviews", "summary", "meta"] },
  "GET /bazars/:idOrSlug/followers": { "dataKeys": ["followers", "meta"] },
  "GET /users/:id/view": { "dataKeys": ["user", "products", "reels", "posts", "viewer"] },
  "GET /users/:id/posts": { "dataKeys": ["posts", "meta"] },
  "GET /users/:id/reels": { "dataKeys": ["reels", "meta"] },
  "GET /users/:id/products": { "dataKeys": ["products", "meta"] },
  "GET /users/:id/followers": { "dataKeys": ["followers", "meta"] },
  "GET /users/:id/following": { "dataKeys": ["following", "meta"] },

  "GET /bazars": { "dataKeys": ["bazars", "meta"] },
  "GET /bazars/:idOrSlug": { "dataKeys": ["bazar"] },
  "GET /bazars/me": { "dataKeys": ["bazar"] },
  "GET /bazars/ranking": { "dataKeys": ["ranking", "period"] },
  "GET /reviews": { "dataKeys": ["reviews", "meta"] },

  "GET /cart": { "dataKeys": ["items", "total"] },
  "GET /orders/mine": { "dataKeys": ["orders", "meta"] },
  "GET /orders/received": { "dataKeys": ["orders", "meta"] },
  "GET /wallet/me": { "dataKeys": ["balance", "transactions", "meta"] },
